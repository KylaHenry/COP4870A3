<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="COP4870.ECommerce.UI.MAUI.CheckoutPage"
             Title="Receipt">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Header -->
            <Label Text="Thank you for your purchase!" 
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label x:Name="DateTimeLabel"
                   FontSize="14"
                   HorizontalOptions="Center" />

            <BoxView HeightRequest="1" Color="Gray" />

            <!-- Receipt Grid -->
            <VerticalStackLayout x:Name="ReceiptItemsLayout" />

            <BoxView HeightRequest="1" Color="Gray" />

            <!-- Totals -->
            <Label x:Name="SubtotalLabel" FontSize="16" FontAttributes="Bold" HorizontalOptions="End" />
            <Label x:Name="TaxLabel" FontSize="16" FontAttributes="Bold" HorizontalOptions="End" />
            <Label x:Name="TotalLabel" FontSize="18" FontAttributes="Bold" TextColor="Green" HorizontalOptions="End" />

            <!-- Buttons -->
            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                <Button Text="Continue Shopping" Clicked="OnContinueShoppingClicked" />
                <Button Text="Main Menu" Clicked="OnMainMenuClicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
