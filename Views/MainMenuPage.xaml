<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EcommerceApp.Views.MainMenuPage"
             Title="Main Menu">

    <VerticalStackLayout Padding="20">
        <Label Text="Welcome to eCommerce App" FontSize="24" HorizontalOptions="Center"/>
        <Button Text="Inventory" Clicked="OnInventoryClicked"/>
        <Button Text="Tax Settings" Clicked="OnTaxSettingsClicked" Margin="0,10" BackgroundColor="LightGray" TextColor="Black" />
        <Button Text="Cart" Clicked="OnCartClicked"/>
    </VerticalStackLayout>
</ContentPage>
