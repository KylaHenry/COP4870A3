<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="COP4870.ECommerce.UI.MAUI.ShoppingCartPage"
             Title="Shopping Cart">


    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="10">

        <!-- Sort Picker -->
        <Picker x:Name="SortPicker" Title="Sort by" SelectedIndexChanged="OnSortChanged">
            <Picker.Items>
                <x:String>Name</x:String>
                <x:String>Price</x:String>
            </Picker.Items>
        </Picker>
        
        <!-- Filter Picker -->
        <Picker x:Name="CartPicker" Title="Select Cart" SelectedIndexChanged="OnCartChanged" />
        
        
        <Button Text="New Cart" Clicked="OnNewCartClicked" />

        <!-- Cart List -->
        <ListView x:Name="CartListView" HasUnevenRows="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame BorderColor="LightGray" Padding="10" Margin="5">
                            <VerticalStackLayout>
                                <Label Text="{Binding Product.Name}" FontAttributes="Bold" FontSize="18"/>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Quantity, StringFormat='Qty: {0}'}"/>
                                    <Label Text="{Binding Product.Price, StringFormat='@ ${0:F2}'}"/>
                                    <Label Text="{Binding LineTotal, StringFormat='= ${0:F2}'}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="+" CommandParameter="{Binding Product.Id}" Clicked="OnIncreaseQuantityClicked"/>
                                    <Button Text="−" CommandParameter="{Binding Product.Id}" Clicked="OnDecreaseQuantityClicked"/>
                                    <Button Text="Remove" CommandParameter="{Binding Product.Id}" Clicked="OnRemoveFromCartClicked" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Totals -->
        <Label x:Name="SubtotalLabel" FontSize="16" FontAttributes="Bold"/>
        <Label x:Name="TaxLabel" FontSize="16" FontAttributes="Bold"/>
        <Label x:Name="TotalLabel" FontSize="18" FontAttributes="Bold" TextColor="DarkGreen"/>

        <!-- Buttons -->
        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
            <Button Text="Continue Shopping" Clicked="OnContinueShoppingClicked" />
            <Button Text="Checkout" Clicked="OnCheckoutClicked" />
        </HorizontalStackLayout>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
